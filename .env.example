# --- Server ---
PORT=3014
HOST=0.0.0.0
LOG_LEVEL=info
# Set true only behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
# Serve HTTPS directly (PEM files). Leave empty when a reverse proxy terminates TLS.
TLS_CERT_PATH=
TLS_KEY_PATH=
BODY_LIMIT=65536

# --- Storage ---
DB_PATH=./data/export.db
# Where the automatic pre-migration snapshot is written. Empty = next to DB_PATH.
DB_BACKUP_DIR=

# --- Callers: id:secret[:role], comma separated. Secrets >= 32 chars, unique. Generate: openssl rand -hex 32
# Roles: write (start, cancel, retry, delete), read (list, get, download, sources, stats, metrics), readwrite (default).
EXPORT_API_KEYS=atc-console:REPLACE_WITH_64_HEX_CHARS
RATE_LIMIT_MAX=600

# --- Destination (required): export files are private files in atc-media. A default-role media key.
# atc-media must list text/csv and application/x-ndjson in its ALLOWED_TYPES, and its MAX_UPLOAD_BYTES must be >= EXPORT_MAX_BYTES.
MEDIA_URL=http://127.0.0.1:3003
MEDIA_API_KEY=REPLACE_WITH_THE_EXPORT_KEY_FROM_MEDIA_API_KEYS

# --- Completion e-mails (optional, both or neither): atc-notify's "generic" template.
NOTIFY_URL=
NOTIFY_API_KEY=
# Shown as the sender application in those e-mails.
EXPORT_APP_NAME=atc-web

# --- Sources (each optional, both or neither): only configured sources are offered. Read-role keys.
SOURCE_AUDIT_URL=
SOURCE_AUDIT_API_KEY=
SOURCE_AUTH_URL=
SOURCE_AUTH_API_KEY=
SOURCE_SHORTLINK_URL=
SOURCE_SHORTLINK_API_KEY=
SOURCE_FLAGS_URL=
SOURCE_FLAGS_API_KEY=
SOURCE_MEDIA_URL=
SOURCE_MEDIA_API_KEY=
SOURCE_CONTENT_URL=
SOURCE_CONTENT_API_KEY=

# --- Worker ---
WORKER_CONCURRENCY=2
POLL_MS=1000
# A job's lease; the heartbeat (at most half of it) renews it and picks up cancel requests.
LEASE_MS=60000
HEARTBEAT_MS=15000
# On shutdown, running exports are handed back to the queue within this time (max 25000).
DRAIN_MS=10000
# Runs per job before a transient failure (upstream down, 5xx, 429) is final; backoff 30 s, 60 s, 120 s ...
MAX_ATTEMPTS=3
# Retries per source request on transient errors, before the run counts as failed.
REQUEST_RETRIES=3
UPSTREAM_TIMEOUT_MS=15000
UPLOAD_TIMEOUT_MS=600000

# --- Limits and retention ---
EXPORT_MAX_ROWS=100000
EXPORT_MAX_BYTES=20971520
# Finished jobs and their files are deleted after this many days.
EXPORT_RETENTION_DAYS=7
# Lifetime of a download URL.
DOWNLOAD_TTL_SEC=300

# --- Audit (optional): forward write and security events to the audit service. Both or neither. A write-role key: AUDIT_API_KEYS=atc-export:…:write
AUDIT_URL=
AUDIT_API_KEY=
